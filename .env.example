# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=fund_dashboard

# JWT Secret Key (สร้างด้วย: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-change-this-in-production

# Email Configuration (สำหรับส่ง verification email)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Google OAuth (จาก Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Frontend URL
FRONTEND_URL=https://ideatradefund.com
WP_SITE_URL=https://yourdomain.com

# Environment
ENVIRONMENT=production
DEBUG=False
```
